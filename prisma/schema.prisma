generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Stores the offline access token per Shopify shop after OAuth install.
model ShopSession {
  id             String    @id @default(cuid())
  shop           String    @unique
  accessToken    String
  scope          String?
  tokenExpiresAt DateTime?
  installedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Local billing record per shop. Access is ALWAYS decided from Shopify's live
// `currentAppInstallation.activeSubscriptions`; this table only stores the
// merchant's explicit Free-plan choice (per installation) and diagnostics.
// Deleted on app/uninstalled so a reinstall must go through plan approval again.
model ShopBilling {
  id                    String    @id @default(cuid())
  shop                  String    @unique
  installationId        String?
  freePlanSelectedAt    DateTime?
  subscriptionId        String?
  subscriptionStatus    String?
  pendingSubscriptionId String?
  pendingPlan           String?
  lastChargeResult      String?   // "accepted" | "declined" | "unknown"
  lastChargeAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Audit log of bulk edit operations for the merchant to review.
model EditLog {
  id          String   @id @default(cuid())
  shop        String
  productId   String
  productTitle String?
  changes     String   // JSON string describing applied changes
  previousValues String? // JSON snapshot of values BEFORE the edit (for Undo)
  undone      Boolean  @default(false)
  undoneAt    DateTime?
  success     Boolean  @default(true)
  errorMsg    String?
  createdAt   DateTime @default(now())

  @@index([shop, createdAt])
}

// Counts how many products were processed per shop per calendar month (UTC).
model UsageCounter {
  id        String   @id @default(cuid())
  shop      String
  period    String   // "YYYY-MM" (UTC)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([shop, period])
}

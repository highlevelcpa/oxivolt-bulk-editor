# ===== OXIVOLT Bulk Editor — Environment Variables (Railway) =====

# Shopify App Credentials (partners.shopify.com -> your app -> Client credentials)
SHOPIFY_API_KEY=<your_shopify_client_id>
SHOPIFY_API_SECRET=<your_shopify_client_secret>
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations

# PostgreSQL connection string (Railway injects this automatically if you add a
# Postgres plugin and reference it — otherwise paste your DB URL here)
DATABASE_URL=<your_postgresql_connection_string>

# Google Gemini API key (powers the AI editing features) — FREE tier
# Get one at https://aistudio.google.com/apikey
#
# MULTI-KEY FAILOVER: add several keys to keep the AI working after one key
# hits its free-tier daily/minute limit. The app tries them in order and
# automatically switches to the next key on quota/rate-limit errors.
# Two ways (you can mix them):
#   1) Comma-separated in this one variable:
#        GEMINI_API_KEY=key1,key2,key3
#   2) Numbered extra variables (GEMINI_API_KEY_2 ... up to _10):
#        GEMINI_API_KEY=key1
#        GEMINI_API_KEY_2=key2
#        GEMINI_API_KEY_3=key3
GEMINI_API_KEY=<your_gemini_api_key>

# Abacus.AI RouteLLM key (OPTIONAL) — used as a final fallback for the AI
# features when every Gemini key above is exhausted. Get one at
# https://apps.abacus.ai/ -> API Keys.
ABACUS_API_KEY=<your_abacus_api_key>

# ===== Shopify Billing API (Manual pricing) =====
# IMPORTANT: in the Partner Dashboard -> your app -> Distribution / Pricing,
# the app must use MANUAL pricing (Billing API), not "Managed pricing".
# Every install/reinstall must pick a plan before the editor unlocks; paid
# plans are created with appSubscriptionCreate and must be approved by the
# merchant inside Shopify.
#
# Offer the Free plan (100 products per operation). true | false
BILLING_FREE_PLAN_ENABLED=true
# Free-trial days for paid plans (0 = no trial)
BILLING_TRIAL_DAYS=0
# Currency of the paid plans
BILLING_CURRENCY=USD
# Paid plan prices
BILLING_PRO_MONTHLY_PRICE=29.99
BILLING_PRO_ANNUAL_PRICE=99.99
# Test charges: auto = test charges only on development stores, true = always
# (use while Shopify reviews the app), false = always real charges
BILLING_TEST_MODE=auto
